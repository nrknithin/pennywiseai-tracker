release.properties

# Signing config and Firebase credentials. Owner-only files that live outside
# the repo (docs/NEEDS-YOU.md, "Release keystore" and "Firebase project"); the
# patterns are deliberately unanchored so a root copy and an app/ copy are both
# ignored. Nothing here exists yet, and the point is that it never lands in a
# commit if it starts to. See CLAUDE.md hard constraint: no credentials.
keystore.properties
google-services.json
secrets.properties

*.pem

# Root-level deploy script may hold credentials; keep it local.
# (Scoped to root so committed helper scripts like
# pennywise-web/scripts/deploy.sh are still tracked.)
/deploy.sh

# Generated Docker build context for the web container (staged copy of
# parser-core created by pennywise-web/scripts/deploy.sh).
/pennywise-web/.parser-core/

# IDE folders
.idea
.vscode

# VSCode build files
parser-core/bin/*

.antigravitycli/*
# Local Play service-account key (used by scripts/upload-play.sh)
play-store-key.json
*play-store*.json

# Local secrets / keys folder — manually backed up, NEVER committed
secrets/

# Local tooling (screenshot editor, agent skills) — not part of the app
aso-screenshots/
.agents/
skills-lock.json

# Release-notes generator (Claude Agent SDK) deps — package-lock.json is
# committed for reproducible installs; only the installed modules are ignored.
scripts/release-notes/node_modules/

# Codegraph index
.codegraph/

# iOS fastlane env (ASC key/issuer IDs)
iosApp/fastlane/.env

# fastlane run artifact (regenerated every run)
iosApp/fastlane/report.xml

# git worktrees (superpowers SDD)
.worktrees/

# Build specification for the Fin fork - derived from a personal mailbox,
# so it stays local (see CLAUDE.md hard constraint 4: no PII in the repo).
spec/
