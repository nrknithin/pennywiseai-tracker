<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
        <!-- Fin: the Gmail app password never goes to cloud backup (spec 04 section 4.1). -->
        <exclude domain="sharedpref" path="fin_email_credentials.xml"/>
    </cloud-backup>
    <!--
      Fin: device-to-device transfer is NOT covered by android:allowBackup="false" on
      Android 12+, so this exclusion is the only thing stopping the credential file from
      being copied to a new phone. The master key stays in the old phone's Keystore, so the
      copy would be undecryptable — but the user should re-enter the password knowingly
      rather than land in an AUTH_FAILED they cannot explain.
    -->
    <device-transfer>
        <exclude domain="sharedpref" path="fin_email_credentials.xml"/>
    </device-transfer>
</data-extraction-rules>
